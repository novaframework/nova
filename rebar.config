%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

{minimum_otp_vsn, "27"}.
{erl_opts, [debug_info]}.
{src_dirs, ["src", "src/controllers"]}.
{erlydtl_opts, [{doc_root, "src/views"},
                {recursive, true},
               {libraries, [
                           {nova_erlydtl_inventory, nova_erlydtl_inventory}
                           ]},
               {default_libraries, [nova_erlydtl_inventory]}
               ]}.

{deps, [
        {cowboy, "~> 2.21.0"},
        {erlydtl, "0.14.0"},
        {jhn_stdlib, "5.11.2"},
        {telemetry, "1.4.2"}
       ]}.

{profiles, [
            {prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]},
            {test, [
                {erl_opts, [debug_info]},
                {deps, [{proper, "1.4.0"}, {meck, "1.1.1"}, {thoas, "1.2.1"}]},
                %% nova_test_app is a real Nova application that nova_full_app_SUITE
                %% boots on a Cowboy listener, so framework-level regressions are
                %% caught here rather than downstream.
                {project_app_dirs, [".", "test/nova_test_app", "test/nova_test_sub_app"]}
            ]},
            %% `elp eqwalize-all` reads this profile (see .elp.toml): eqwalizer_support
            %% holds the specs eqWAlizer needs for OTP's generic functions.
            {eqwalizer, [
                {deps, [
                    {eqwalizer_support,
                        {git_subdir, "https://github.com/WhatsApp/erlang-language-platform.git",
                            {tag, "2026-08-07"}, "eqwalizer/eqwalizer_support"}}
                ]}
            ]}
           ]}.

{dialyzer, [
            {warnings, [
                        unknown
                       ]},
            {plt_apps, all_deps},
            {plt_extra_apps, [jhn_stdlib,
                              edoc,
                              xmerl,
                              cowboy,
                              erlydtl,
                              cowlib]}
           ]}.

{xref_checks,[
              undefined_function_calls,
              undefined_functions,
              locals_not_used,
              deprecated_function_calls,
              deprecated_functions
             ]}.


{plugins, [rebar3_ex_doc,
           {rebar3_erlydtl_plugin, ".*",
            {git, "https://github.com/erlydtl/rebar3_erlydtl_plugin.git", {ref, "f1ed9486"}}},
           rebar3_mutate
          ]}.

{project_plugins, [{rebar3_hex, "~> 7.5"}]}.


{provider_hooks, [
                  {pre, [{compile, {erlydtl, compile}}]}
                 ]}.

{ex_doc, [{proglang, erlang},
          {main, <<"quick-start">>},
          {assets, #{<<"guides/assets">> => <<"guides/assets">>}},
          {extras, [<<"guides/quick-start.md">>,
                    <<"guides/rebar3_nova.md">>,
                    <<"guides/request-lifecycle.md">>,
                    <<"guides/configuration.md">>,
                    <<"guides/routing.md">>,
                    <<"guides/controllers.md">>,
                    <<"guides/views.md">>,
                    <<"guides/plugins.md">>,
                    <<"guides/sessions.md">>,
                    <<"guides/websockets.md">>,
                    <<"guides/pubsub.md">>,
                    <<"guides/handlers.md">>,
                    <<"guides/error-handling.md">>,
                    <<"guides/watchers.md">>,
                    <<"guides/security.md">>,
                    <<"guides/testing.md">>,
                    <<"guides/building-releases.md">>,
                    <<"guides/graceful-shutdown.md">>,
                    <<"guides/logging.md">>,
                    <<"guides/telemetry.md">>,
                    <<"guides/multi-app.md">>,
                    <<"guides/upgrading.md">>,
                    <<"guides/deprecations.md">>,
                    {<<"SECURITY.md">>, #{filename => <<"security-policy">>,
                                          title => <<"Security policy">>}},
                    <<"guides/books-and-links.md">>]},
          {groups_for_extras, [{<<"Getting started">>, [<<"guides/quick-start.md">>,
                                                        <<"guides/rebar3_nova.md">>,
                                                        <<"guides/request-lifecycle.md">>]},
                               {<<"Building an application">>, [<<"guides/configuration.md">>,
                                                                <<"guides/routing.md">>,
                                                                <<"guides/controllers.md">>,
                                                                <<"guides/views.md">>,
                                                                <<"guides/plugins.md">>,
                                                                <<"guides/sessions.md">>,
                                                                <<"guides/websockets.md">>,
                                                                <<"guides/pubsub.md">>,
                                                                <<"guides/handlers.md">>,
                                                                <<"guides/error-handling.md">>,
                                                                <<"guides/watchers.md">>]},
                               {<<"Security and testing">>, [<<"guides/security.md">>,
                                                             <<"guides/testing.md">>,
                                                             <<"SECURITY.md">>]},
                               {<<"Operations">>, [<<"guides/building-releases.md">>,
                                                   <<"guides/graceful-shutdown.md">>,
                                                   <<"guides/logging.md">>,
                                                   <<"guides/telemetry.md">>,
                                                   <<"guides/multi-app.md">>]},
                               {<<"Upgrading">>, [<<"guides/upgrading.md">>,
                                                  <<"guides/deprecations.md">>]},
                               {<<"Further reading">>, [<<"guides/books-and-links.md">>]}]},
          {source_url, <<"https://github.com/novaframework/nova">>},
          {homepage_url, <<"https://novaframework.org">>}
         ]
}.

{hex, [
  {doc, #{provider => ex_doc}}
]}.

%% cowboy hex package declares deps with "and" syntax that rebar3 cannot parse.
{overrides, [{override, cowboy, [{deps, [{cowlib, "2.22.0"}, {ranch, "2.4.0"}]}]}]}.
