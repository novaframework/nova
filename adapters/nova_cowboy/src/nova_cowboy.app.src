{application, nova_cowboy,
 [{description, "Run Nova on the Cowboy HTTP server"},
  {vsn, git},
  {registered, [nova_cowboy_sup]},
  {mod, {nova_cowboy_app, []}},
  {applications,
   [kernel,
    stdlib,
    ranch,
    cowboy,
    nova
   ]},
  {env, []},
  {modules, []},
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/novaframework/nova"}]}
 ]}.
