%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

{minimum_otp_vsn, "27"}.
{erl_opts, [debug_info]}.

{deps, [
        {nova, "~> 1.0"},
        {ranch, "~> 2.4"},
        {cowboy, "~> 2.21.0"}
       ]}.

%% cowboy hex package declares deps with "and" syntax that rebar3 cannot parse.
{overrides, [{override, cowboy, [{deps, [{cowlib, "2.22.0"}, {ranch, "2.4.0"}]}]}]}.
